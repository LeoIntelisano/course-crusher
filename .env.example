# Copy to .env (gitignored) and fill in. `jac run` loads it at startup.

# --- AI breakdown (byLLM via LiteLLM). Set the key for the model you use. ---
# Default model is gpt-4o-mini (see [byllm.model] in jac.toml).
OPENAI_API_KEY=
# To use Claude instead:
# LLM_MODEL=claude-sonnet-4-6
# ANTHROPIC_API_KEY=

# --- Google Calendar (web app). OAuth client of type "Web application". ---
# Keep the JSON outside the repo.
GOOGLE_WEB_CLIENT_SECRETS_FILE=
# Must match an "Authorized redirect URI" on that client.
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/connections/google/callback

# --- Google Calendar (CLI: jac run cli -- free-slots --google). "Desktop app" client. ---
GOOGLE_CLIENT_SECRETS_FILE=

# --- Production only ---
# JWT signing secret (dev servers generate one per project).
# JAC_SERVE_AUTH_SECRET=
# Initial password for the built-in /admin portal (logs, LLM telemetry). Defaults to "changeme".
# JAC_ADMIN_PASSWORD=

# --- End-to-end runs without an API key: canned breakdown output. Never set in production. ---
# COURSE_CRUSHER_LLM_FIXTURE=e2e/breakdown_fixture.json
